# Elastic Cloud credentials (copy to .env and fill in values)
# Do not commit .env — it is gitignored.

# ── Track A: Logstash → Elastic Cloud (required for default docker compose) ─
# Elasticsearch HTTPS URL (replace .kb. with .es. from your Kibana URL)
# Example: https://<deployment>.es.us-east-2.aws.elastic-cloud.com:443
ELASTICSEARCH_URL=

# API key with write + auto_configure on metrics-snmp.* and logs-snmp.*
# (key only, without "ApiKey " prefix)
ES_API_KEY=

# Logstash / Elastic Stack image version — match your Elastic Cloud major version
STACK_VERSION=9.0.0

# Optional: Cloud ID (not required if ELASTICSEARCH_URL is set)
# ES_CLOUD_ID=

# ── Track B: topology sample data (optional) ───────────────────────────────
# Usually same as ELASTICSEARCH_URL / ES_API_KEY
# ELASTICSEARCH_URL is shared with Track A above
ELASTIC_API_KEY=

# Optional: basic auth fallback for local Elasticsearch
# ELASTIC_USER=elastic
# ELASTIC_PASSWORD=changeme

# ── Optional OTEL path (profile: otel) ─────────────────────────────────────
# OTLP ingest endpoint
# Example: https://<deployment-id>.ingest.us-central1.gcp.elastic.cloud:443
ELASTIC_CLOUD_INGEST_ENDPOINT=

# Full Authorization header value for OTLP export (include "ApiKey " prefix)
# Example: ApiKey base64encodedkey==
ELASTIC_OTLP_AUTHORIZATION=
